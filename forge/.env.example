# Sauvegarde et synchronisation sur Supabase.
#
# Les deux valeurs se trouvent dans Supabase, menu Project Settings → API.
# En production elles se posent dans Vercel (Settings → Environment Variables) ;
# ce fichier ne sert qu'au développement local : copiez-le en .env.local.
#
# Sans elles, l'application fonctionne en local sur le téléphone, sans sauvegarde
# en ligne.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Adresse du compte créé dans Supabase (Authentication → Users). Le code d'accès
# demandé par l'application est le mot de passe de ce compte.
# VITE_SUPABASE_COMPTE=moi@forge.local
