# Partage des commandes entre plusieurs téléphones.
#
# Ces deux valeurs se trouvent dans Supabase, menu Project Settings → API.
# En production elles se posent dans Vercel (Settings → Environment Variables) ;
# ce fichier ne sert qu'au développement local : copiez-le en .env.local.
#
# Sans elles, l'application fonctionne en local sur chaque appareil, sans partage.

VITE_SUPABASE_URL=https://votre-projet.supabase.co
VITE_SUPABASE_ANON_KEY=votre-cle-publique-anon

# Adresse du compte partagé, à changer seulement si vous en avez utilisé une
# autre en créant l'utilisateur dans Supabase (et dans supabase/schema.sql).
# VITE_SUPABASE_COMPTE=service@grill.local
